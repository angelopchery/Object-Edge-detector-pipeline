# Original photos never leave this machine via git
data/raw/
YoloData/

# Dataset images are distributed via download_data.py, not git.
# Label files and the split manifest ARE committed (annotation is auditable work).
data/dataset/images/
data/prepared/
data/*.zip

# Training outputs
runs/

# Model weights: ignored in general (runs/ churns them), EXCEPT the final
# deliverables in models/ — yolo11n weights are ~5 MB, well inside git limits.
*.pt
*.onnx
!models/*.pt
!models/*.onnx

# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# Virtual environments
artikate/
venv/
.venv/
env/

# OS / editor noise
Thumbs.db
.DS_Store
.vscode/
.idea/
data/*.resolved.yaml
*.cache
